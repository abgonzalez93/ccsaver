#!/bin/sh
hook=$1
[ -n "$hook" ] || exit 0
dir=$(cd "${CLAUDE_PROJECT_DIR:-$PWD}" 2>/dev/null && pwd -P) || exit 0
home="${CCSAVER_HOME:-$HOME/.config/ccsaver}"
[ -r "$home/plugged" ] || exit 0
limit=200000
if [ "$hook" = handoff ] && [ -e "$home/handoff.json" ]; then
  if [ -r "$home/handoff.json" ]; then
    while IFS= read -r line; do
      case $line in
      *'"on"'*:*false*) exit 0 ;;
      *'"limit"'*) limit=${line#*:} ;;
      esac
    done < "$home/handoff.json"
  else
    limit=
  fi
fi
best=
while IFS='	' read -r root adapter <&3; do
  [ -n "$root" ] || continue
  case "$dir/" in "$root"/*) [ ${#root} -gt ${#best} ] && { best=$root; deepest=$adapter; } ;; esac
done 3< "$home/plugged"
[ -n "$best" ] || exit 0
start() {
  NODE_COMPILE_CACHE="${NODE_COMPILE_CACHE:-$home/cache}"
  export NODE_COMPILE_CACHE
  exec node "$(dirname "$0")/../src/$1.hook.ts"
}
if [ "$hook" = read-gate ]; then
  [ -z "$deepest" ] && [ ! -e "$home/log" ] || start read-gate
fi
input=
while IFS= read -r line; do input="$input$line
"; done
input=$input$line
defer() {
  printf '%s' "$input" | start "$hook"
  exit
}
field() {
  value=${input#*"\"$1\":\""}
  [ "$value" != "$input" ] || return 1
  value=${value%%\"*}
  case $value in *\\*) return 1 ;; esac
}
small() {
  [ -f "$1" ] && [ -r "$1" ] || return 1
  set -- $({ wc -lc < "$1"; } 2>/dev/null)
  [ "${1:-350}" -lt 350 ] && [ "${2:-32001}" -le 32000 ]
}
count() {
  value=${line#*"\"$1\":"}
  [ "$value" != "$line" ] || return 1
  value=${value%%[!0-9]*}
  [ -n "$value" ]
}
if [ "$hook" = handoff ]; then
  case $input in *'"agent_id":"'*) exit 0 ;; esac
  nl='
'
  limit=${limit#"${limit%%[! ]*}"}
  limit=${limit%%[!0-9]*}
  case $limit in '' | 0*) defer ;; esac
  field hook_event_name || defer
  event=$value
  field session_id || defer
  session=$value
  case $session in '' | *[!A-Za-z0-9._-]*) defer ;; esac
  [ ${#session} -le 200 ] || defer
  [ -e "$home/handoff/$session.asked" ] && defer
  field transcript_path || defer
  path=$value
  case $path in /*) ;; *) defer ;; esac
  [ -f "$path" ] && [ -r "$path" ] || defer
  case $event in
  PreToolUse)
    field tool_use_id || defer
    case $value in '' | *[!A-Za-z0-9_-]*) defer ;; esac
    found=$(tail -c 16384 "$path" | grep -aF -- "\"id\":\"$value\"") ;;
  UserPromptSubmit)
    found=$(tail -c 16384 "$path" | grep -a -- '"role":"assistant"' | tail -n 1) ;;
  *) defer ;;
  esac
  line=${found##*"$nl"}
  case $line in *'"role":"assistant"'*) ;; *) defer ;; esac
  case $line in *'"isSidechain":true'* | *'<synthetic>'* | *[!\}]) defer ;; esac
  count input_tokens || defer
  size=$value
  count cache_creation_input_tokens || defer
  size=$((size + value))
  count cache_read_input_tokens || defer
  size=$((size + value))
  count output_tokens || defer
  size=$((size + value))
  point=$((limit - 80000))
  if [ "$event" = PreToolUse ]; then
    count apiBlockIndex || defer
    [ $((size + value * 8000)) -le "$point" ] && exit 0
  else
    [ "$size" -lt "$point" ] && exit 0
  fi
  defer
fi
fields=${input#*'"tool_input":{'}
[ "$fields" != "$input" ] || defer
fields=${fields%%\}*}
case $fields in
*\\* | *null*) defer ;;
*'"offset"'* | *'"limit"'* | *'"pages"'*) exit 0 ;;
esac
path=${fields#*'"file_path":"'}
[ "$path" != "$fields" ] || defer
case $path in
/*\"*) path=${path%%\"*} ;;
*) defer ;;
esac
small "$path" && exit 0
defer
