#!/bin/sh
dir=$(cd "${CLAUDE_PROJECT_DIR:-$PWD}" 2>/dev/null && pwd -P) || exit 0
home="${CCSAVER_HOME:-$HOME/.config/ccsaver}"
[ -r "$home/plugged" ] || exit 0
while IFS='	' read -r root _ <&3; do
  [ -n "$root" ] || continue
  case "$dir/" in "$root"/*)
    NODE_COMPILE_CACHE="$home/cache"
    export NODE_COMPILE_CACHE
    exec node "$(dirname "$0")/../src/read-gate.hook.ts" 3<&-
    ;;
  esac
done 3< "$home/plugged"
exit 0
