{
  "name": "ccsaver",
  "version": "0.9.5",
  "private": true,
  "description": "Claude Code plugin that keeps whole-file reads and boilerplate writing out of the expensive model's context by delegating them to a cheap one-shot worker, only in the projects you plug in.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "test": "CCSAVER_HOME=/nonexistent/ccsaver node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check . --write",
    "deps:check": "pnpm outdated || true",
    "deps:update": "pnpm update --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.5",
    "typescript": "^7.0.2"
  }
}
