#!/bin/sh
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P) || exit 1
plain() {
  printf '%s' "$1" | tr -d '\001-\010\013-\037\177'
}

said() {
  if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
    printf '\033[%sm%s%s\033[0m %s\n' "$1" "$2" "${3:+ $3}" "$4" >&2
  else
    printf '%s%s\n' "${3:+$3 }" "$4" >&2
  fi
}

home=${CCSAVER_HOME:-$HOME/.config/ccsaver}
case $home in
/*) ;;
*)
  said 31 ✗ Error: "CCSAVER_HOME must be an absolute path, this one is not: $(plain "$home")"
  exit 1
  ;;
esac

if [ -d "$home" ]; then
  NODE_COMPILE_CACHE="$home/cache"
  export NODE_COMPILE_CACHE
fi

cli() {
  node "$root/src/cli.ts" "$@"
}

store_key() {
  umask 077
  mkdir -p "$home" && chmod 700 "$home" || return 1
  if [ -t 0 ]; then
    trap 'stty echo' EXIT INT TERM
    stty -echo
    printf 'API key (input hidden): ' >&2
    IFS= read -r key
    stty echo
    trap - EXIT INT TERM
    printf '\n' >&2
  else
    IFS= read -r key
  fi
  if [ -z "$key" ]; then
    said 31 ✗ Error: "empty key, nothing was written"
    return 1
  fi
  if [ -f "$home/api-key" ]; then kept=replaced; else kept=stored; fi
  printf '%s\n' "$key" > "$home/api-key.new" && mv "$home/api-key.new" "$home/api-key" || return 1
  chmod 600 "$home/api-key"
  if [ -d "$home/log" ]; then
    now=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)
    (printf '{"v":1,"ts":"%s","kind":"config","session":null,"pid":%s,"action":"key set"}\n' "$now" "$$" >> "$home/log/events-${now%%-[0-9][0-9]T*}.jsonl") 2>/dev/null
  fi
  said 32 ✓ '' "key $kept in $(plain "$home")/api-key (600)"
}

asked() {
  printf '%s' "$1" >&2
  IFS= read -r reply || return 1
  [ -n "$reply" ] || { said 31 ✗ Error: "nothing typed, setup stopped"; return 1; }
}

if [ "$1" = key ] && [ "$2" = set ] && [ $# -eq 2 ]; then
  store_key || exit 1
  said 36 → '' "check it with: ccsaver doctor"
  exit 0
fi

case "$1" in
doctor | setup | plug)
  if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 24 || (major === 24 && minor >= 2) || (major === 22 && minor >= 18) ? 0 : 1)' 2>/dev/null; then
    echo "FAIL node: ccsaver needs Node.js 22.18+ or 24.2+, this PATH has $(node --version 2>/dev/null || echo none)"
    exit 1
  fi
  ;;
esac

if [ "$1" = setup ]; then
  asked 'worker url (https://…/v1/chat/completions): ' || exit 1
  url=$reply
  asked 'worker model: ' || exit 1
  cli worker set "$url" "$reply" || exit 1
  store_key || exit 1
  printf 'let paid Claude Haiku answer what the worker cannot? [Y/n] ' >&2
  IFS= read -r reply
  case $reply in [Nn]*) cli fallback off || exit 1 ;; *) cli fallback on || exit 1 ;; esac
  cli doctor
  exit $?
fi

exec node "$root/src/cli.ts" "$@"
