#!/bin/sh
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P) || exit 1
home=${CCSAVER_HOME:-$HOME/.config/ccsaver}

if [ "$1" = key ] && [ "$2" = set ]; then
  umask 077
  mkdir -p "$home" && chmod 700 "$home" || exit 1
  if [ -t 0 ]; then
    trap 'stty echo' EXIT INT TERM
    stty -echo
    printf 'API key (input hidden): ' >&2
    IFS= read -r key
    stty echo
    trap - EXIT INT TERM
    printf '\n' >&2
  else
    IFS= read -r key
  fi
  if [ -z "$key" ]; then
    echo "Error: empty key, nothing was written" >&2
    exit 1
  fi
  printf '%s\n' "$key" > "$home/api-key.new" && mv "$home/api-key.new" "$home/api-key" || exit 1
  chmod 600 "$home/api-key"
  if [ -d "$home/log" ]; then
    now=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)
    (printf '{"v":1,"ts":"%s","kind":"config","session":null,"pid":%s,"action":"key set"}\n' "$now" "$$" >> "$home/log/events-${now%%-[0-9][0-9]T*}.jsonl") 2>/dev/null
  fi
  echo "key stored in $home/api-key (600); check it with: ccsaver doctor" >&2
  exit 0
fi

if [ "$1" = doctor ] && ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || (major === 22 && minor >= 18) ? 0 : 1)' 2>/dev/null; then
  echo "FAIL node: ccsaver needs Node.js 22.18 or newer, this PATH has $(node --version 2>/dev/null || echo none)"
  exit 1
fi

if [ -d "$home" ]; then
  NODE_COMPILE_CACHE="$home/cache"
  export NODE_COMPILE_CACHE
fi
exec node "$root/src/cli.ts" "$@"
